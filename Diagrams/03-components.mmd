C4Component
title PetCare Home Services - C4 Component Diagram

Container_Boundary(backend, "NestJS PetCare Backend") {
  Component(http, "HTTP Interface", "PetcareController", "Expone la API REST.")
  Component(application, "Application Facade", "PetcareApplicationService", "Coordina las operaciones de la aplicación.")
  Component(payments, "Payments Domain", "PaymentsDomainService", "Confirma pagos y publica payment.confirmed.")
  Component(eventBus, "Event Bus Adapter", "CloudAmqpEventBusService", "Publica, consume y reintenta eventos.")
  Component(consumer, "Payment Consumer", "PaymentConfirmedConsumer", "Recibe el pago confirmado.")
  Component(bookings, "Bookings Domain", "BookingsDomainService", "Valida reglas y crea la reserva.")
  Component(persistence, "Persistence Adapter", "MysqlPersistenceService", "Guarda el estado de la aplicación.")
}

System_Ext(web, "PetCare Web", "Next.js", "Cliente web responsive.")
System_Ext(rabbitmq, "RabbitMQ", "CloudAMQP", "Broker de eventos.")
System_Ext(mysql, "MySQL", "Aiven / mysql2", "Persistencia del estado.")
System_Ext(deadLetter, "Dead-letter Queue", "RabbitMQ", "Eventos que no pueden procesarse.")

Rel(web, http, "Solicita", "HTTP/JSON")
Rel(http, application, "Invoca")
Rel(application, payments, "Inicia pago")
Rel(payments, eventBus, "Publica payment.confirmed")
Rel(eventBus, rabbitmq, "Envía y consume", "AMQP/TLS")
Rel(eventBus, consumer, "Despacha payment.confirmed")
Rel(consumer, bookings, "Crea reserva")
Rel(bookings, persistence, "Lee y guarda")
Rel(persistence, mysql, "Persiste", "SQL/TLS")
Rel(eventBus, deadLetter, "Aísla fallos")

UpdateElementStyle(http, $bgColor="#438dd5", $fontColor="white")
UpdateElementStyle(application, $bgColor="#4d9bd5", $fontColor="white")
UpdateElementStyle(payments, $bgColor="#f0ad4e", $fontColor="black")
UpdateElementStyle(eventBus, $bgColor="#f0ad4e", $fontColor="black")
UpdateElementStyle(consumer, $bgColor="#4d9bd5", $fontColor="white")
UpdateElementStyle(bookings, $bgColor="#6fa9d7", $fontColor="black")
UpdateElementStyle(persistence, $bgColor="#777777", $fontColor="white")
UpdateElementStyle(rabbitmq, $bgColor="#f0ad4e", $fontColor="black")
UpdateElementStyle(mysql, $bgColor="#777777", $fontColor="white")
UpdateElementStyle(deadLetter, $bgColor="#d9534f", $fontColor="white")
