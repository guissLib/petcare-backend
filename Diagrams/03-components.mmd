C4Component
title PetCare Home Services - C4 Component Diagram

Container_Boundary(backend, "NestJS PetCare Backend") {
  Container_Boundary(httpLayer, "interfaces/http") {
    Component(controller, "PetcareController", "NestJS Controller", "Mapea rutas REST, parámetros, cuerpos y respuestas HTTP.")
  }

  Container_Boundary(applicationLayer, "application") {
    Component(facade, "PetcareApplicationService", "Application Service", "Expone una fachada estable y coordina los paquetes de dominio.")
    Component(store, "PetcareStoreService", "Application Service", "Carga el estado inicial y delega la persistencia.")
    Component(port, "PetcarePersistence", "Port / interface", "Contrato de load, save e isAvailable para la persistencia.")
    Component(eventPort, "PetcareEventBus", "Port / interface", "Contrato para publicar y consumir eventos de dominio.")
    Component(consumer, "PaymentConfirmedConsumer", "Application Consumer", "Escucha payment.confirmed y delega la creación de la reserva.")
  }

  Container_Boundary(domainLayer, "domains") {
    Component(users, "UsersDomainService", "Domain package", "Crea, lista y busca usuarios.")
    Component(pets, "PetsDomainService", "Domain package", "Gestiona mascotas y registros de vacunación.")
    Component(providers, "ProvidersDomainService", "Domain package", "Consulta proveedores y valida disponibilidad.")
    Component(promotions, "PromotionsDomainService", "Domain package", "Administra promociones nacionales y locales.")
    Component(bookings, "BookingsDomainService", "Domain package", "Aplica reglas de reserva, capacidad y estados.")
    Component(notifications, "NotificationsDomainService", "Domain package", "Genera confirmaciones, recordatorios y eventos.")
    Component(payments, "PaymentsDomainService", "Domain package", "Procesa pagos mock con referencias MOCK-*.")
    Component(maps, "MapsDomainService", "Domain package", "Geocodifica direcciones de forma determinística.")
  }

  Container_Boundary(infrastructureLayer, "infrastructure/persistence") {
    Component(mysql, "MysqlPersistenceService", "Infrastructure adapter / mysql2", "Implementa el puerto y guarda PetcareState en MySQL.")
  }

  Container_Boundary(messagingLayer, "infrastructure/messaging") {
    Component(amqp, "CloudAmqpEventBusService", "Infrastructure adapter / amqplib", "Publica y consume eventos mediante CloudAMQP.")
  }
}

ContainerDb(db, "petcare_state", "MySQL", "Estado JSON persistido del backend.")
System_Ext(broker, "CloudAMQP", "RabbitMQ", "Exchange y cola durable de eventos.")
System_Ext(dlq, "Dead-letter Queue", "RabbitMQ", "Eventos descartados por errores permanentes.")
System_Ext(client, "PetCare Web", "Next.js", "Cliente web responsive.")

Rel(client, controller, "Realiza solicitudes", "HTTP/JSON")
Rel(controller, facade, "Invoca operaciones")
Rel(facade, users, "Coordina")
Rel(facade, pets, "Coordina")
Rel(facade, providers, "Coordina")
Rel(facade, promotions, "Coordina")
Rel(facade, bookings, "Coordina")
Rel(facade, notifications, "Coordina")
Rel(facade, payments, "Coordina")
Rel(facade, maps, "Coordina")
Rel(consumer, eventPort, "Se suscribe a payment.confirmed")
Rel(eventPort, consumer, "Entrega eventos")
Rel(consumer, bookings, "Solicita crear reserva")
Rel(users, store, "Lee/escribe estado")
Rel(pets, store, "Lee/escribe estado")
Rel(providers, store, "Consulta reservas")
Rel(promotions, store, "Lee/escribe estado")
Rel(bookings, users, "Valida propietario")
Rel(bookings, pets, "Valida mascota y vacunas")
Rel(bookings, providers, "Valida proveedor y disponibilidad")
Rel(bookings, promotions, "Calcula descuentos")
Rel(bookings, notifications, "Emite eventos")
Rel(payments, store, "Persiste payment")
Rel(store, port, "Usa contrato")
Rel(port, mysql, "Delegación de persistencia")
Rel(mysql, db, "Lee/escribe", "SQL/TLS")
