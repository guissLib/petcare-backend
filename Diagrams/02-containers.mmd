C4Container
title PetCare Home Services - C4 Container Diagram

Person(owner, "Dueño de mascota", "Consulta servicios, paga y agenda reservas.")
Person(provider, "Proveedor", "Gestiona servicios y reservas.")

System_Boundary(petcare, "PetCare Home Services") {
  Container(frontend, "PetCare Web", "Next.js", "Interfaz web responsive para clientes y proveedores.")
  Container(backend, "PetCare Backend", "NestJS / TypeScript", "API REST, reglas de negocio, pagos y reservas.")
  Container(rabbitmq, "RabbitMQ Event Broker", "CloudAMQP / AMQP", "Transporta el evento payment.confirmed y gestiona reintentos.")
}

Rel(owner, frontend, "Usa")
Rel(provider, frontend, "Usa")
Rel(frontend, backend, "Consume API REST", "HTTP/JSON")
Rel(backend, rabbitmq, "Publica payment.confirmed", "AMQP/TLS")
Rel(rabbitmq, backend, "Entrega eventos para crear reservas", "AMQP/TLS")

UpdateElementStyle(frontend, $bgColor="#ef846c", $fontColor="white")
UpdateElementStyle(backend, $bgColor="#438dd5", $fontColor="white")
UpdateElementStyle(rabbitmq, $bgColor="#f0ad4e", $fontColor="black")
