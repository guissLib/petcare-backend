C4Container
title PetCare Home Services - C4 Container Diagram

Person(owner, "Dueño de mascota", "Agenda y consulta reservas.")
Person(provider, "Proveedor", "Administra servicios y estados.")
System_Ext(web, "PetCare Web", "Next.js", "Dashboard responsive para consumir la API.")

System_Boundary(petcare, "PetCare Home Services") {
  Container(http, "HTTP Interface", "NestJS Controller", "Expone rutas REST y el contrato Swagger.")
  Container(application, "Application Facade", "NestJS Provider", "Orquesta los casos de uso sin contener reglas específicas de un dominio.")
  Container(domains, "Domain Packages", "TypeScript / NestJS", "Users, pets, providers, promotions, bookings, notifications, payments y maps.")
  Container(store, "PetCare Store", "NestJS Provider", "Mantiene el estado de la aplicación y coordina carga y guardado.")
  Container(port, "Persistence Port", "TypeScript interface", "Abstrae la persistencia para mantener desacoplados los dominios.")
  Container(swagger, "Swagger UI", "OpenAPI", "Documenta y permite probar la API.")
}

ContainerDb(mysql, "MySQL Persistence", "MySQL / mysql2", "Tabla petcare_state con el estado persistido. Se activa con MYSQL_ENABLED=true.")

Rel(owner, web, "Usa")
Rel(provider, web, "Usa")
Rel(web, http, "Consume", "HTTP/JSON")
Rel(owner, swagger, "Explora endpoints", "HTTP")
Rel(http, application, "Invoca casos de uso")
Rel(swagger, http, "Consulta contrato OpenAPI")
Rel(application, domains, "Coordina operaciones")
Rel(domains, store, "Lee y modifica estado")
Rel(store, port, "Carga y persiste mediante")
Rel(port, mysql, "Implementado por el adaptador MySQL", "SQL/TLS")

UpdateElementStyle(http, $bgColor="#438dd5", $fontColor="white")
UpdateElementStyle(application, $bgColor="#4d9bd5", $fontColor="white")
UpdateElementStyle(domains, $bgColor="#85bbf0", $fontColor="black")
UpdateElementStyle(store, $bgColor="#9fc7df", $fontColor="black")
UpdateElementStyle(port, $bgColor="#c8dce8", $fontColor="black")
UpdateElementStyle(mysql, $bgColor="#777777", $fontColor="white")
