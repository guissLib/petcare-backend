C4Container
title PetCare Home Services - Diagrama de Contenedores


Person(owner, "Dueño de mascota", "Consulta servicios, paga y agenda reservas.")
Person(provider, "Proveedor", "Gestiona servicios y reservas.")


System_Ext(google_maps, "Google Maps Platform", "Proporciona mapas, geolocalización y cálculo de rutas.")
System_Ext(cloudamqp, "CloudAMQP", "Servicio administrado que proporciona RabbitMQ para mensajería.")


System_Boundary(petcare, "PetCare System") {
    Container(frontend, "PetCare Web", "Next.js", "Interfaz web para clientes y proveedores.")
    Container(api_gateway, "PetCare API Gateway", "NestJS / TypeScript", "Único punto público; autentica y enruta booking, catálogo y checkout a Booking Service.")
    Container(backend, "PetCare Backend Service", "NestJS / TypeScript", "Autenticación y contextos maestros; publica contexto versionado y Payment consume comandos asíncronos.")
    Container(booking_service, "Booking Service", "NestJS / TypeScript", "Acepta reservas provisionales, tokeniza tarjeta mock en memoria y confirma por comandos Saga idempotentes.")
    Container(orchestrator, "Orchestration Service", "NestJS / TypeScript", "Inicia una Saga durable en booking.requested y encola comandos Payment mediante outbox.")
    ContainerDb(database, "PetCare Database", "MySQL", "Contextos maestros, Payment e inbox/outbox transaccionales. No contiene Booking.")
    ContainerDb(booking_write_database, "Booking Write Database", "MySQL", "Agregado Booking, reservas provisionales/confirmadas, inbox y outbox.")
    ContainerDb(booking_read_database, "Booking Read/Context Database", "MySQL separado", "Modelo CQRS y copia local eventualmente consistente de catálogo y contexto.")
    ContainerDb(orchestration_database, "Orchestration Database", "MySQL", "Estado durable de Sagas, correlación, inbox y outbox transaccional.")
}


Rel(owner, frontend, "Usa", "HTTPS")
Rel(provider, frontend, "Usa", "HTTPS")


Rel(frontend, api_gateway, "Consume la API pública", "JSON/HTTPS")
Rel(api_gateway, backend, "Enruta login, usuarios, mascotas, proveedores y mapas", "JSON/HTTP")
Rel(api_gateway, booking_service, "Enruta booking, catálogo y checkout", "JSON/HTTP")
Rel(backend, database, "Persiste contexto, Payment e inbox/outbox", "MySQL/TLS")
Rel(booking_service, booking_write_database, "Persiste provisional/confirmada + inbox/outbox", "MySQL/TLS")
Rel(booking_service, booking_read_database, "Lee contexto y actualiza CQRS", "MySQL/TLS")
Rel(backend, google_maps, "Consulta mapas, ubicaciones y rutas", "HTTPS/API")
BiRel(backend, cloudamqp, "Publica context.*.vN y respuestas Payment; consume comandos durables con inbox", "AMQP/RabbitMQ")
BiRel(booking_service, cloudamqp, "Consume contexto/confirmación con inbox; publica booking.requested con outbox", "AMQP/RabbitMQ")
BiRel(orchestrator, cloudamqp, "Consume booking.requested/respuestas; publica payment.intent.create y captura o pago en sitio", "AMQP/RabbitMQ")
Rel(orchestrator, orchestration_database, "Persiste Sagas y outbox", "MySQL/TLS")


UpdateRelStyle(owner, frontend, $offsetX="-40", $offsetY="-20")
UpdateRelStyle(provider, frontend, $offsetX="40", $offsetY="-20")
UpdateRelStyle(frontend, api_gateway, $offsetY="-35")
UpdateRelStyle(api_gateway, backend, $offsetY="-35")
UpdateRelStyle(api_gateway, booking_service, $offsetY="-35")
UpdateRelStyle(backend, database, $offsetY="35")
UpdateRelStyle(booking_service, booking_write_database, $offsetY="35")
UpdateRelStyle(backend, google_maps, $offsetY="-30")
UpdateRelStyle(backend, cloudamqp, $offsetY="-30")
UpdateRelStyle(orchestrator, cloudamqp, $offsetY="-30")
UpdateRelStyle(orchestrator, orchestration_database, $offsetY="35")


UpdateElementStyle(frontend, $bgColor="#ef846c", $fontColor="white")
UpdateElementStyle(api_gateway, $bgColor="#f6b26b", $fontColor="black")
UpdateElementStyle(backend, $bgColor="#438dd5", $fontColor="white")
UpdateElementStyle(booking_service, $bgColor="#2f75b5", $fontColor="white")
UpdateElementStyle(database, $bgColor="#4ade80", $fontColor="black")
UpdateElementStyle(booking_write_database, $bgColor="#4ade80", $fontColor="black")
UpdateElementStyle(booking_read_database, $bgColor="#93c5fd", $fontColor="black")
UpdateElementStyle(google_maps, $bgColor="#f0ad4e", $fontColor="black")
UpdateElementStyle(cloudamqp, $bgColor="#f0ad4e", $fontColor="black")
UpdateElementStyle(orchestrator, $bgColor="#8e7cc3", $fontColor="white")
UpdateElementStyle(orchestration_database, $bgColor="#4ade80", $fontColor="black")


UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
