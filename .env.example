MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=petcare
MYSQL_USER=petcare
MYSQL_PASSWORD=change-me
MYSQL_POOL_SIZE=10
MYSQL_SSL=false
# Ruta relativa al backend o ruta absoluta del certificado CA de MySQL.
MYSQL_SSL_CA=
TYPEORM_LOGGING=false

# RabbitMQ/CloudAMQP para confirmar reservas de forma asíncrona.
# Se acepta CLOUDAMQP_URL por compatibilidad con CloudAMQP.
CLOUDAMQP_URL=
RABBITMQ_URL=
RABBITMQ_EXCHANGE=petcare.events
RABBITMQ_PAYMENT_CONFIRMED_QUEUE=petcare.booking.payment-confirmed
RABBITMQ_PAYMENT_CONFIRMED_DLQ=petcare.booking.payment-confirmed.dlq
RABBITMQ_DEAD_LETTER_EXCHANGE=petcare.events.dead

# Autenticación JWT. Usa un secreto aleatorio de al menos 32 caracteres.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_EXPIRES_IN_SECONDS=3600

# Google Maps: la clave de servidor nunca debe exponerse al navegador.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=

# Seed inicial. No uses estos valores en producción.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_NAME=PetCare Administrator
ADMIN_SEED_PASSWORD=change-this-password-with-at-least-12-characters
ADMIN_SEED_CITY=Bogotá
ADMIN_SEED_PHONE=

