# Activar persistencia MySQL
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=petcare
MYSQL_USER=petcare
MYSQL_PASSWORD=petcare
MYSQL_POOL_SIZE=10
MYSQL_SSL=false

# CloudAMQP / RabbitMQ
# CLOUDAMQP_URL=amqps://usuario:password@host/vhost
AMQP_EXCHANGE=petcare.events
AMQP_QUEUE=petcare.bookings.payment-confirmed
AMQP_ROUTING_KEY=payment.confirmed
AMQP_PREFETCH=10
AMQP_DEAD_LETTER_QUEUE=petcare.bookings.payment-confirmed.dead-letter
AMQP_MAX_RETRIES=3

